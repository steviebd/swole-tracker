{
  "name": "swole-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "bun run lint && bun run typecheck && bun run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push --force",
    "db:push:dev": "infisical run --env dev -- drizzle-kit push --force",
    "db:push:staging": "infisical run --env staging -- drizzle-kit push --force",
    "db:push:prod": "infisical run --env prod -- drizzle-kit push --force",
    "db:push:all": "bun run db:push:dev && bun run db:push:staging && bun run db:push:prod",
    "db:studio": "drizzle-kit studio",
    "dev": "(fuser -k 8787/tcp 2>/dev/null || lsof -ti :8787 | xargs kill -9 2>/dev/null || true) && infisical run --env dev -- bun scripts/update-wrangler-config.ts dev && infisical run --env dev -- vite dev --port 8787",
    "dev:secrets": "bun scripts/update-wrangler-config.ts dev",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "tokens:build": "bun scripts/generate-theme-tokens.ts && bun scripts/build-material3-css.ts",
    "secrets": "bun scripts/update-secrets-cache.ts",
    "setup-d1-databases": "bun scripts/setup-d1-databases.ts",
    "test": "vitest run",
    "test:fast": "vitest run --config vitest.config.fast.ts",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:changed": "vitest run --changed --no-coverage --reporter=basic",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:flow": "SLOW_MO=500 bunx playwright test e2e/workflow/full-workout-flow.spec.ts --headed --project=chromium",
    "test:e2e:plateau": "SLOW_MO=500 bunx playwright test e2e/workflow/plateau-detection-flow.spec.ts --headed --project=chromium",
    "test:all": "bun run test && bun run test:e2e",
    "test:performance": "node scripts/test-performance-monitor.js",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/query-sync-storage-persister": "^5.90.5",
    "@tanstack/react-form": "^1.23.8",
    "@tanstack/react-query": "^5.90.3",
    "@tanstack/react-query-persist-client": "^5.90.5",
    "@tanstack/react-router": "^1.150.0",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.150.0",
    "@tanstack/react-store": "^0.8.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@tanstack/zod-form-adapter": "^0.42.1",
    "@workos-inc/node": "^7.71.0",
    "ai": "5.0.68",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-browserify": "^3.12.1",
    "date-fns": "^4.1.0",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.44.6",
    "framer-motion": "^12.23.24",
    "https-browserify": "^1.0.0",
    "lucide-react": "^0.545.0",
    "oauth4webapi": "^3.8.2",
    "postgres": "^3.4.7",
    "posthog-js": "^1.275.3",
    "posthog-node": "^5.10.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.65.0",
    "recharts": "^3.2.1",
    "server-only": "^0.0.1",
    "stream-http": "^3.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@ai-sdk/provider": "2.0.0",
    "@ai-sdk/provider-utils": "3.0.12",
    "@cloudflare/vite-plugin": "^1.21.0",
    "@cloudflare/workers-types": "^4.20251011.0",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@tanstack/router-plugin": "^1.150.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/recharts": "^2.0.1",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "baseline-browser-mapping": "^2.9.15",
    "buffer": "^6.0.3",
    "eslint": "^9.37.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.0.10",
    "jsdom": "^27.0.0",
    "msw": "^2.11.5",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.14",
    "tailwindcss-animate": "1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "bun@1.2.21",
  "volta": {
    "node": "24.3.0"
  }
}
